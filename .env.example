# Local-development placeholders only; replace before deployment.
POSTGRES_DB=file_metadata
POSTGRES_USER=fileadmin
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://fileadmin:change-me@postgres:5432/file_metadata
REDIS_URL=redis://redis:6379/0
MINIO_BUCKET=distributed-files
STORAGE_NODE_COUNT=3
STORAGE_REPLICATION_FACTOR=3
STORAGE_NODE_1_NAME=node-1
STORAGE_NODE_1_ACCESS_KEY=replace-node1-access
STORAGE_NODE_1_SECRET_KEY=replace-node1-secret
STORAGE_NODE_1_CAPACITY_BYTES=10737418240
STORAGE_NODE_2_NAME=node-2
STORAGE_NODE_2_ACCESS_KEY=replace-node2-access
STORAGE_NODE_2_SECRET_KEY=replace-node2-secret
STORAGE_NODE_2_CAPACITY_BYTES=10737418240
STORAGE_NODE_3_NAME=node-3
STORAGE_NODE_3_ACCESS_KEY=replace-node3-access
STORAGE_NODE_3_SECRET_KEY=replace-node3-secret
STORAGE_NODE_3_CAPACITY_BYTES=10737418240
STORAGE_NODE_4_NAME=node-4
STORAGE_NODE_4_ACCESS_KEY=replace-node4-access
STORAGE_NODE_4_SECRET_KEY=replace-node4-secret
STORAGE_NODE_4_CAPACITY_BYTES=10737418240
STORAGE_HEARTBEAT_TTL_SECONDS=60
STORAGE_HEALTH_INTERVAL_SECONDS=10
REPLICATION_JOB_LEASE_SECONDS=300
REPLICATION_POLL_SECONDS=2
REPLICATION_MAX_ATTEMPTS=5
RABBITMQ_USER=dfms-worker
RABBITMQ_PASSWORD=replace-with-a-unique-rabbitmq-password
RABBITMQ_VHOST=/
RABBITMQ_CONNECTION_TIMEOUT_SECONDS=5
OUTBOX_POLL_SECONDS=1
ETCD_ROOT_PASSWORD=replace-with-a-unique-etcd-root-password
ETCD_USERNAME=dfms-worker
ETCD_PASSWORD=replace-with-a-different-etcd-service-password
ETCD_TIMEOUT_SECONDS=5
ETCD_MEMBERSHIP_TTL_SECONDS=30
ETCD_LEADER_TTL_SECONDS=30
COORDINATION_POLL_SECONDS=5
RECONCILIATION_INTERVAL_SECONDS=30
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
